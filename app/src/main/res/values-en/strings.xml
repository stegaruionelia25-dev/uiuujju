    <string name="perm_accessibility">Accessibility service</string>
    <string name="perm_active">Active</string>
    <string name="perm_inactive">Inactive</string>
    <string name="perm_accessibility_body">ProfitRide reads visible text in Bolt and Uber to find an offer\'s price, distance and time. It uses only the accessibility permission, with no access to other data.</string>
    <string name="perm_open_accessibility">Open accessibility settings</string>
    <string name="perm_how_title">How to turn it on</string>
    <string name="perm_how_steps">1. Open accessibility settings.\n2. Choose Installed apps or Downloaded services.\n3. Tap ProfitRide and switch it on.</string>
    <string name="perm_restricted_hint">If Android says \"Restricted setting\", open App info, tap ⋮ and choose \"Allow restricted settings\", then try again.</string>
    <string name="perm_open_app_details">Open app info</string>
    <string name="perm_privacy_title">Privacy</string>
    <string name="perm_privacy_body">The app has no internet access. Offers and history stay on your phone and can be deleted at any time.</string>

