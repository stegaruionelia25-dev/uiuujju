    <string name="app_name">ProfitRide</string>
    <string name="service_label">ProfitRide</string>
    <string name="service_description">ProfitRide reads the visible text in Bolt Driver and Uber Driver only to calculate the net profit of a ride and show it on screen. If text is not available it can take a screenshot, processed only on your phone and not saved. It never taps anything, never accepts or declines rides, and sends no data anywhere.</string>

