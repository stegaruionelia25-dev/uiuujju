    <string name="ob_welcome_title">Your real profit at a glance</string>
    <string name="ob_welcome_sub">It takes a minute. Then ProfitRide shows the net profit of every ride, right over Bolt and Uber.</string>
    <string name="ob_example_label">Example</string>
    <string name="ob_tut1_title">Exact math</string>
    <string name="ob_tut1_sub">From the offer\'s price, kilometres and minutes it subtracts commission, fuel, wear and your taxes.</string>
    <string name="ob_tut2_title">Stays out of the way</string>
    <string name="ob_tut2_sub">It sits in the middle of the screen, never covers the price, route or buttons, and can\'t be tapped.</string>
    <string name="ob_tut3_title">You decide</string>
    <string name="ob_tut3_sub">ProfitRide only displays. It never accepts or declines a ride for you.</string>
